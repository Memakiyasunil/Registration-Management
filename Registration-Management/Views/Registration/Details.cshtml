@model RegistrationDetailsViewModel
@{
    ViewData["Title"] = "User Profile";
    var user = Model.User;
    var userInitial = !string.IsNullOrEmpty(user.Name) ? user.Name.Substring(0, 1).ToUpper() : "U";
}

<!-- Page Header & Breadcrumbs -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <nav class="breadcrumb-nav">
            <a asp-action="Index">Registrations</a>
            <span class="breadcrumb-separator">/</span>
            <span>@user.Name</span>
        </nav>
        <h1 class="page-title">User Profile</h1>
        <p class="page-subtitle">Detailed registration information and document attachments.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-primary">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
            </svg>
            Edit Profile
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to List
        </a>
    </div>
</div>

<!-- Profile Overview Header Card -->
<div class="saas-card mb-4">
    <div class="saas-card-body p-4">
        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="user-avatar-lg">@userInitial</span>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h3 class="h4 mb-0 fw-bold">@user.Name</h3>
                        <span class="saas-badge @(user.Gender == "Male" ? "badge-gender-male" : user.Gender == "Female" ? "badge-gender-female" : "badge-gender-other")">
                            @user.Gender
                        </span>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-3 text-secondary small">
                        <span class="font-monospace">@@@user.Username</span>
                        <span>•</span>
                        <span>@user.CityName, @user.StateName</span>
                        <span>•</span>
                        <span>Registered @user.CreatedDate.ToString("dd MMMM yyyy")</span>
                    </div>
                </div>
            </div>
            <span class="saas-badge" style="background:#dcfce7; color:#15803d; border:1px solid #86efac;">
                ● Active Account
            </span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Main Column (Left) -->
    <div class="col-lg-8">

        <!-- 1. Personal & Location Information -->
        <div class="saas-card mb-4">
            <div class="saas-card-header">
                <div class="d-flex align-items-center">
                    <svg class="saas-card-header-icon" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                    <span>General Information</span>
                </div>
            </div>
            <div class="saas-card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="detail-group">
                            <div class="detail-label-subtle">Full Name</div>
                            <div class="detail-value-prominent">@user.Name</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-group">
                            <div class="detail-label-subtle">Username</div>
                            <div class="detail-value-prominent font-monospace">@@@user.Username</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-group">
                            <div class="detail-label-subtle">Date of Birth</div>
                            <div class="detail-value-prominent">@user.DateOfBirth.ToString("dd MMMM yyyy")</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-group">
                            <div class="detail-label-subtle">Pincode</div>
                            <div class="detail-value-prominent font-monospace">@user.Pincode</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="detail-group">
                            <div class="detail-label-subtle">Street Address</div>
                            <div class="detail-value-prominent">@user.Address</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-group">
                            <div class="detail-label-subtle">State</div>
                            <div class="detail-value-prominent">@user.StateName</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-group">
                            <div class="detail-label-subtle">City</div>
                            <div class="detail-value-prominent">@user.CityName</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="detail-group">
                            <div class="detail-label-subtle">Registration Date</div>
                            <div class="detail-value-prominent">@user.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                        </div>
                    </div>
                    @if (user.ModifiedDate.HasValue)
                    {
                        <div class="col-sm-6">
                            <div class="detail-group">
                                <div class="detail-label-subtle">Last Modified</div>
                                <div class="detail-value-prominent">@user.ModifiedDate.Value.ToString("dd MMM yyyy, hh:mm tt")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 2. Attached Documents -->
        <div class="saas-card mb-4">
            <div class="saas-card-header">
                <div class="d-flex align-items-center">
                    <svg class="saas-card-header-icon" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.89 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/>
                    </svg>
                    <span>Attached Documents</span>
                </div>
                <span class="badge-stat">@Model.Documents.Count Files</span>
            </div>
            <div class="saas-card-body p-0">
                @if (!Model.Documents.Any())
                {
                    <div class="text-center text-muted py-4 small">No documents attached to this registration.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table saas-table mb-0">
                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Type</th>
                                    <th>Size</th>
                                    <th>Uploaded</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <svg width="18" height="18" fill="#4f46e5" viewBox="0 0 24 24" class="me-2 flex-shrink-0">
                                                    <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.89 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z"/>
                                                </svg>
                                                <span class="fw-medium text-truncate">@doc.OriginalFileName</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="saas-badge" style="background:#f1f5f9; color:#475569; border:1px solid #e2e8f0;">
                                                @doc.FileExtension.Replace(".", "").ToUpper()
                                            </span>
                                        </td>
                                        <td class="small text-muted">@FormatSize(doc.FileSizeBytes)</td>
                                        <td class="small text-muted">@doc.UploadedDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-action="ViewDocument" asp-route-id="@doc.DocumentId"
                                                   class="btn btn-sm btn-outline-secondary" target="_blank" title="View Document">
                                                    View
                                                </a>
                                                <a asp-action="DownloadDocument" asp-route-id="@doc.DocumentId"
                                                   class="btn btn-sm btn-outline-secondary" title="Download Document">
                                                    Download
                                                </a>
                                                <form asp-action="DeleteDocument" method="post" class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this document?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="documentId" value="@doc.DocumentId" />
                                                    <input type="hidden" name="userId" value="@user.UserId" />
                                                    <button type="submit" class="btn btn-sm text-danger border-0 p-1" title="Delete Document">
                                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                                            <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- Sidebar Column (Right) -->
    <div class="col-lg-4">

        <!-- 3. Selected Hobbies Card -->
        <div class="saas-card mb-4">
            <div class="saas-card-header">
                <div class="d-flex align-items-center">
                    <svg class="saas-card-header-icon" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                    <span>Selected Hobbies</span>
                </div>
            </div>
            <div class="saas-card-body">
                @if (!Model.Hobbies.Any())
                {
                    <div class="text-muted small">No hobbies selected.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var h in Model.Hobbies)
                        {
                            <span class="hobby-chip selected" style="cursor:default;">
                                <span class="hobby-chip-check">✓</span>
                                <span>@h.HobbyName</span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- 4. Quick Actions Card -->
        <div class="saas-card">
            <div class="saas-card-body">
                <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-primary w-100 py-2 mb-2">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" class="me-1">
                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                    </svg>
                    Edit Registration
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 py-2">
                    Back to Registrations
                </a>
            </div>
        </div>

    </div>
</div>

@functions {
    string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1048576) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1048576.0:F1} MB";
    }
}
