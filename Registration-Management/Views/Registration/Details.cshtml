@model RegistrationDetailsViewModel
@{
    ViewData["Title"] = "Registration Details";
    var user = Model.User;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title">
        <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24" class="me-2" style="vertical-align:-4px">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
        </svg>
        Registration Details
    </h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-warning">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" class="me-1">
                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
            </svg>
            Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Personal Info -->
    <div class="col-lg-8">
        <div class="card form-card mb-4">
            <div class="card-header form-card-header">Personal Information</div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-label">Full Name</div>
                        <div class="detail-value">@user.Name</div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">Username</div>
                        <div class="detail-value">
                            <span class="badge bg-light text-dark border fs-6">@user.Username</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Date of Birth</div>
                        <div class="detail-value">@user.DateOfBirth.ToString("dd MMMM yyyy")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Gender</div>
                        <div class="detail-value">
                            <span class="badge @(user.Gender == "Male" ? "bg-primary" : user.Gender == "Female" ? "bg-pink" : "bg-secondary") fs-6">
                                @user.Gender
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Pincode</div>
                        <div class="detail-value">@user.Pincode</div>
                    </div>
                    <div class="col-12">
                        <div class="detail-label">Address</div>
                        <div class="detail-value">@user.Address</div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">State</div>
                        <div class="detail-value">@user.StateName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">City</div>
                        <div class="detail-value">@user.CityName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail-label">Registered On</div>
                        <div class="detail-value">@user.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt")</div>
                    </div>
                    @if (user.ModifiedDate.HasValue)
                    {
                        <div class="col-md-6">
                            <div class="detail-label">Last Modified</div>
                            <div class="detail-value">@user.ModifiedDate.Value.ToString("dd MMMM yyyy, hh:mm tt")</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Documents -->
        <div class="card form-card">
            <div class="card-header form-card-header d-flex justify-content-between align-items-center">
                <span>
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" class="me-2">
                        <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.89 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/>
                    </svg>
                    Documents
                </span>
                <span class="badge bg-white text-dark border">@Model.Documents.Count file(s)</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Documents.Any())
                {
                    <div class="text-center text-muted py-4">No documents uploaded.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>File Name</th>
                                    <th>Type</th>
                                    <th>Size</th>
                                    <th>Uploaded</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td>
                                            <svg width="16" height="16" fill="#6366f1" viewBox="0 0 24 24" class="me-2">
                                                <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.89 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z"/>
                                            </svg>
                                            @doc.OriginalFileName
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@doc.FileExtension.ToUpper()</span></td>
                                        <td class="small text-muted">@FormatSize(doc.FileSizeBytes)</td>
                                        <td class="small text-muted">@doc.UploadedDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a asp-action="ViewDocument" asp-route-id="@doc.DocumentId"
                                                   class="btn btn-sm btn-outline-primary" target="_blank" title="View">
                                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                                                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                                    </svg>
                                                    View
                                                </a>
                                                <a asp-action="DownloadDocument" asp-route-id="@doc.DocumentId"
                                                   class="btn btn-sm btn-outline-success" title="Download">
                                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                                                        <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                                                    </svg>
                                                    Download
                                                </a>
                                                <form asp-action="DeleteDocument" method="post" class="d-inline"
                                                      onsubmit="return confirm('Delete this document?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="documentId" value="@doc.DocumentId" />
                                                    <input type="hidden" name="userId" value="@user.UserId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                                                            <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Hobbies -->
    <div class="col-lg-4">
        <div class="card form-card">
            <div class="card-header form-card-header">Hobbies</div>
            <div class="card-body p-3">
                @if (!Model.Hobbies.Any())
                {
                    <div class="text-muted">No hobbies selected.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var h in Model.Hobbies)
                        {
                            <span class="badge-hobby-lg">@h.HobbyName</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1048576) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1048576.0:F1} MB";
    }
}
