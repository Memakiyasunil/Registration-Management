@model RegistrationViewModel
@{
    ViewData["Title"] = "Edit Registration";
}

<div class="page-header mb-4">
    <h1 class="page-title">
        <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24" class="me-2" style="vertical-align:-4px">
            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
        </svg>
        Edit Registration
    </h1>
    <p class="text-muted">Update registration details. Password is not changed unless a new one is entered.</p>
</div>

<form asp-action="Edit" asp-controller="Registration" method="post" enctype="multipart/form-data" id="registrationForm" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            <strong>Please fix the following errors:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Personal Information -->
            <div class="card form-card mb-4">
                <div class="card-header form-card-header">Personal Information</div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label required-label">Full Name</label>
                            <input asp-for="Name" class="form-control" id="Name" placeholder="Enter full name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label required-label">Username</label>
                            <input asp-for="Username" class="form-control" id="Username" placeholder="Username" autocomplete="off" />
                            <div id="usernameStatus" class="mt-1 small"></div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label required-label">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" id="DateOfBirth"
                                   max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")"
                                   value="@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label required-label">Gender</label>
                            <div class="d-flex gap-3 mt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Male" id="genderMale" />
                                    <label class="form-check-label" for="genderMale">Male</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Female" id="genderFemale" />
                                    <label class="form-check-label" for="genderFemale">Female</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Other" id="genderOther" />
                                    <label class="form-check-label" for="genderOther">Other</label>
                                </div>
                            </div>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Pincode" class="form-label required-label">Pincode</label>
                            <input asp-for="Pincode" class="form-control" placeholder="6-digit pincode" maxlength="6" />
                            <span asp-validation-for="Pincode" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Location -->
            <div class="card form-card mb-4">
                <div class="card-header form-card-header">Location Details</div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Address" class="form-label required-label">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter complete address"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StateId" class="form-label required-label">State</label>
                            <select asp-for="StateId" class="form-select" id="StateId">
                                <option value="0">-- Select State --</option>
                                @foreach (var s in Model.States)
                                {
                                    <option value="@s.StateId">@s.StateName</option>
                                }
                            </select>
                            <span asp-validation-for="StateId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CityId" class="form-label required-label">City</label>
                            <select asp-for="CityId" class="form-select" id="CityId">
                                <option value="0">-- Select City --</option>
                                @foreach (var c in Model.Cities)
                                {
                                    <option value="@c.CityId">@c.CityName</option>
                                }
                            </select>
                            <span asp-validation-for="CityId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Existing Documents -->
            @if (Model.ExistingDocuments.Any())
            {
                <div class="card form-card mb-4">
                    <div class="card-header form-card-header">Existing Documents</div>
                    <div class="card-body p-3">
                        @foreach (var doc in Model.ExistingDocuments)
                        {
                            <div class="d-flex align-items-center justify-content-between border-bottom py-2">
                                <span class="small">
                                    <svg width="14" height="14" fill="#6366f1" viewBox="0 0 24 24" class="me-1">
                                        <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.89 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z"/>
                                    </svg>
                                    @doc.OriginalFileName
                                </span>
                                <div class="d-flex gap-1">
                                    <a asp-action="ViewDocument" asp-route-id="@doc.DocumentId"
                                       class="btn btn-xs btn-outline-primary" target="_blank">View</a>
                                    <a asp-action="DownloadDocument" asp-route-id="@doc.DocumentId"
                                       class="btn btn-xs btn-outline-success">Download</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Add More Documents -->
            <div class="card form-card mb-4">
                <div class="card-header form-card-header">
                    Add More Documents
                    <small class="text-muted ms-2">(Optional — max 5 files, 5MB each)</small>
                </div>
                <div class="card-body p-4">
                    <div class="file-drop-zone" id="fileDropZone">
                        <svg width="40" height="40" fill="#94a3b8" viewBox="0 0 24 24" class="mb-2">
                            <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/>
                        </svg>
                        <p class="mb-1 text-muted small">Drag & drop or</p>
                        <input type="file" name="Documents" id="documentsInput"
                               accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
                               multiple class="d-none" />
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                onclick="document.getElementById('documentsInput').click()">Browse Files</button>
                    </div>
                    <div id="fileList" class="mt-2"></div>
                    <div id="fileError" class="text-danger small mt-1"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Hobbies -->
            <div class="card form-card mb-4">
                <div class="card-header form-card-header">Hobbies</div>
                <div class="card-body p-3">
                    <div id="hobbiesError" class="text-danger small mb-2"></div>
                    @foreach (var hobby in Model.AllHobbies)
                    {
                        <div class="form-check hobby-check">
                            <input class="form-check-input" type="checkbox"
                                   name="SelectedHobbyIds" value="@hobby.HobbyId"
                                   id="hobby_@hobby.HobbyId"
                                   @(Model.SelectedHobbyIds.Contains(hobby.HobbyId) ? "checked" : "") />
                            <label class="form-check-label" for="hobby_@hobby.HobbyId">@hobby.HobbyName</label>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="card form-card">
                <div class="card-body p-4">
                    <button type="submit" class="btn btn-warning btn-lg w-100 mb-3">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" class="me-2">
                            <path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/>
                        </svg>
                        Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary w-100">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registration.js" asp-append-version="true"></script>
    <script>
        const checkUsernameUrl = '@Url.Action("CheckUsername", "Registration")';
        const getCitiesUrl = '@Url.Action("GetCities", "Registration")';
        const excludeUserId = @Model.UserId;

        $(document).ready(function () {
            initRegistrationForm();
        });
    </script>
}
