@model RegistrationViewModel
@{
    ViewData["Title"] = "New Registration";
}

<div class="page-header mb-4">
    <h1 class="page-title">
        <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24" class="me-2" style="vertical-align:-4px">
            <path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
        </svg>
        New Registration
    </h1>
    <p class="text-muted">Fill in all required fields to create a new registration.</p>
</div>

<form asp-action="Create" asp-controller="Registration" method="post" enctype="multipart/form-data" id="registrationForm" novalidate>
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            <strong>Please fix the following errors:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column -->
        <div class="col-lg-8">

            <!-- Personal Information Card -->
            <div class="card form-card mb-4">
                <div class="card-header form-card-header">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" class="me-2">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                    Personal Information
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <!-- Name -->
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label required-label">Full Name</label>
                            <input asp-for="Name" class="form-control" id="Name" placeholder="Enter full name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Username -->
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label required-label">Username</label>
                            <div class="input-group">
                                <input asp-for="Username" class="form-control" id="Username"
                                       placeholder="e.g. john_doe123" autocomplete="off" />
                            </div>
                            <div id="usernameStatus" class="mt-1 small"></div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label required-label">Password</label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control" id="Password"
                                       placeholder="Min 8 chars, upper, lower, number, special" />
                                <span class="input-group-text" onclick="togglePwd('Password', this)" style="cursor:pointer">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                    </svg>
                                </span>
                            </div>
                            <div id="pwdStrength" class="mt-1"></div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label required-label">Confirm Password</label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" id="ConfirmPassword"
                                       placeholder="Re-enter password" />
                                <span class="input-group-text" onclick="togglePwd('ConfirmPassword', this)" style="cursor:pointer">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                    </svg>
                                </span>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Date of Birth -->
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label required-label">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" id="DateOfBirth"
                                   max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <!-- Gender -->
                        <div class="col-md-4">
                            <label class="form-label required-label">Gender</label>
                            <div class="d-flex gap-3 mt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Male" id="genderMale" />
                                    <label class="form-check-label" for="genderMale">Male</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Female" id="genderFemale" />
                                    <label class="form-check-label" for="genderFemale">Female</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Other" id="genderOther" />
                                    <label class="form-check-label" for="genderOther">Other</label>
                                </div>
                            </div>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <!-- Pincode -->
                        <div class="col-md-4">
                            <label asp-for="Pincode" class="form-label required-label">Pincode</label>
                            <input asp-for="Pincode" class="form-control" id="Pincode"
                                   placeholder="6-digit pincode" maxlength="6" pattern="[0-9]{6}" />
                            <span asp-validation-for="Pincode" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Address Card -->
            <div class="card form-card mb-4">
                <div class="card-header form-card-header">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" class="me-2">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    Location Details
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <!-- Address -->
                        <div class="col-12">
                            <label asp-for="Address" class="form-label required-label">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="3" id="Address"
                                      placeholder="Enter complete address (min 10 characters)"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- State -->
                        <div class="col-md-6">
                            <label asp-for="StateId" class="form-label required-label">State</label>
                            <select asp-for="StateId" class="form-select" id="StateId">
                                <option value="0">-- Select State --</option>
                                @foreach (var s in Model.States)
                                {
                                    <option value="@s.StateId">@s.StateName</option>
                                }
                            </select>
                            <span asp-validation-for="StateId" class="text-danger small"></span>
                        </div>

                        <!-- City (cascading) -->
                        <div class="col-md-6">
                            <label asp-for="CityId" class="form-label required-label">City</label>
                            <select asp-for="CityId" class="form-select" id="CityId" disabled>
                                <option value="0">-- Select State First --</option>
                                @foreach (var c in Model.Cities)
                                {
                                    <option value="@c.CityId">@c.CityName</option>
                                }
                            </select>
                            <span asp-validation-for="CityId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Documents Card -->
            <div class="card form-card mb-4">
                <div class="card-header form-card-header">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" class="me-2">
                        <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.89 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zm-3-7H9v-2h6v2zm2 4H9v-2h8v2z"/>
                    </svg>
                    Documents
                    <small class="text-muted ms-2">(Max 5 files, 5MB each — PDF, JPG, PNG, DOC, DOCX)</small>
                </div>
                <div class="card-body p-4">
                    <div class="file-drop-zone" id="fileDropZone">
                        <svg width="48" height="48" fill="#94a3b8" viewBox="0 0 24 24" class="mb-2">
                            <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/>
                        </svg>
                        <p class="mb-1 text-muted">Drag & drop files here or</p>
                        <input type="file" name="Documents" id="documentsInput"
                               accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
                               multiple class="d-none" />
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                onclick="document.getElementById('documentsInput').click()">
                            Browse Files
                        </button>
                    </div>
                    <div id="fileList" class="mt-2"></div>
                    <div id="fileError" class="text-danger small mt-1"></div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-4">
            <!-- Hobbies Card -->
            <div class="card form-card mb-4">
                <div class="card-header form-card-header">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" class="me-2">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                    Hobbies
                </div>
                <div class="card-body p-3">
                    <div id="hobbiesError" class="text-danger small mb-2"></div>
                    @foreach (var hobby in Model.AllHobbies)
                    {
                        <div class="form-check hobby-check">
                            <input class="form-check-input" type="checkbox"
                                   name="SelectedHobbyIds" value="@hobby.HobbyId"
                                   id="hobby_@hobby.HobbyId"
                                   @(Model.SelectedHobbyIds.Contains(hobby.HobbyId) ? "checked" : "") />
                            <label class="form-check-label" for="hobby_@hobby.HobbyId">@hobby.HobbyName</label>
                        </div>
                    }
                </div>
            </div>

            <!-- Submit Card -->
            <div class="card form-card">
                <div class="card-body p-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3" id="submitBtn">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" class="me-2">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        Register
                    </button>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary w-100">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registration.js" asp-append-version="true"></script>
    <script>
        // Pass controller URL to JS
        const checkUsernameUrl = '@Url.Action("CheckUsername", "Registration")';
        const getCitiesUrl = '@Url.Action("GetCities", "Registration")';
        const excludeUserId = 0;

        $(document).ready(function () {
            initRegistrationForm();
        });
    </script>
}
