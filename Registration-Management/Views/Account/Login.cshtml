@model Registration_Management.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Registration Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page-container">
        <!-- Left Hero Pane (Desktop) -->
        <div class="login-hero-pane">
            <div class="login-hero-brand">
                <div class="hero-brand-icon">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 3a3 3 0 110 6 3 3 0 010-6zm0 14.2a7.2 7.2 0 01-6-3.22c.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08a7.2 7.2 0 01-6 3.22z"/>
                    </svg>
                </div>
                <span>Registration Management</span>
            </div>

            <div class="login-hero-content">
                <div class="hero-tag">
                    <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    Enterprise Suite
                </div>
                <h1 class="hero-title">Streamlined user registration & directory control.</h1>
                <p class="hero-description">
                    A centralized platform to manage user profiles, dynamic location directories, categorized hobbies, and document attachments with enterprise precision.
                </p>

                <ul class="hero-features">
                    <li class="hero-feature-item">
                        <span class="hero-feature-icon">✓</span>
                        Real-time username verification and validation
                    </li>
                    <li class="hero-feature-item">
                        <span class="hero-feature-icon">✓</span>
                        Multi-criteria search, filtering & sorting
                    </li>
                    <li class="hero-feature-item">
                        <span class="hero-feature-icon">✓</span>
                        Secure multi-document staging & management
                    </li>
                </ul>
            </div>

            <div class="login-hero-footer">
                &copy; @DateTime.UtcNow.Year Registration Management System. All rights reserved.
            </div>
        </div>

        <!-- Right Form Pane -->
        <div class="login-form-pane">
            <div class="login-form-wrapper">
                <div class="login-header-mobile">
                    <div class="hero-brand-icon mx-auto mb-2">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 3a3 3 0 110 6 3 3 0 010-6zm0 14.2a7.2 7.2 0 01-6-3.22c.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08a7.2 7.2 0 01-6 3.22z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold mb-0">Registration Management</h5>
                </div>

                <h2 class="login-form-title">Welcome back</h2>
                <p class="login-form-subtitle">Enter your credentials to access your account</p>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" class="me-2 flex-shrink-0">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        <div>@TempData["Success"]</div>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-3" role="alert">
                            @Html.ValidationSummary(false, null, new { @class = "mb-0 ps-3" })
                        </div>
                    }

                    <!-- Username -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <div class="input-icon-wrapper">
                            <span class="input-leading-icon">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </svg>
                            </span>
                            <input asp-for="Username" class="form-control input-with-leading-icon" id="loginUsername"
                                   placeholder="Enter your username" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label mb-0">Password</label>
                        </div>
                        <div class="input-group">
                            <div class="input-icon-wrapper flex-grow-1">
                                <span class="input-leading-icon">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                                    </svg>
                                </span>
                                <input asp-for="Password" type="password" class="form-control input-with-leading-icon"
                                       id="loginPassword" placeholder="Enter your password" autocomplete="current-password" />
                            </div>
                            <button class="btn btn-outline-secondary input-group-text pwd-toggle-btn" type="button"
                                    onclick="togglePwd('loginPassword', this)" title="Show/Hide password">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" id="pwdEyeIcon">
                                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2" id="loginBtn">
                        <span id="btnText">Sign In</span>
                        <span id="btnSpinner" class="spinner-border spinner-border-sm d-none ms-2" role="status"></span>
                    </button>
                </form>

                <div class="text-center mt-4 pt-2 border-top">
                    <span class="text-muted small">Don't have an account? </span>
                    <a asp-controller="Registration" asp-action="Create" class="text-primary fw-semibold small text-decoration-none">
                        Create registration →
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const eyeSvg = `<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>`;
        const eyeSlashSvg = `<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>`;

        function togglePwd(inputId, btn) {
            var input = document.getElementById(inputId);
            if (!input) return;
            var isPwd = input.type === 'password';
            input.type = isPwd ? 'text' : 'password';
            if (btn) {
                btn.innerHTML = isPwd ? eyeSlashSvg : eyeSvg;
                btn.setAttribute('title', isPwd ? 'Hide password' : 'Show password');
            }
        }

        document.getElementById('loginForm').addEventListener('submit', function () {
            if ($(this).valid()) {
                document.getElementById('btnText').textContent = 'Signing in...';
                document.getElementById('btnSpinner').classList.remove('d-none');
                document.getElementById('loginBtn').disabled = true;
            }
        });
    </script>
</body>
</html>
